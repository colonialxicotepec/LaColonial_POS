# Normalización de fin de línea
* text=auto eol=lf

# Código y datos
*.py    text eol=lf
*.js    text eol=lf
*.css   text eol=lf
*.html  text eol=lf
*.json  text eol=lf
*.md    text eol=lf
*.txt   text eol=lf

# Scripts de Windows
*.bat   text eol=crlf
*.cmd   text eol=crlf

# Binarios
*.db    binary
*.sqlite binary
*.xlsx  binary
*.png   binary
*.jpg   binary
*.ico   binary
